{
  "rewrites": [
    {
      "source": "/404.html",
      "destination": "/404.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "Accept",
          "value": "(.*text/html.*)"
        }
      ],
      "destination": "/index.html"
    }
  ],
  "cleanUrls": false
}